# Root Compose configuration. Copy to .env and replace with a random value.
# Generate a value with: openssl rand -hex 32
PROXY_SHARED_SECRET=

# Optional operations integrations. Leave empty until you connect owned services.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=reeltogether/backups
BACKUP_S3_ENCRYPTION=AES256
BACKUP_S3_KMS_KEY_ID=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ENABLE_PERIODIC_SYNC=false
