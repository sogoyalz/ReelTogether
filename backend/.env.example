ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./movie_analytics.db
REDIS_URL=redis://localhost:6379/0
TMDB_API_KEY=
YOUTUBE_API_KEY=
OMDB_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest
AI_CHAT_PROVIDER=openai
# Opt-in Movie Match interpretation; requires OPENAI_API_KEY and sign-in.
ENABLE_ASSISTANT_AI=false
ASSISTANT_AI_CALLS_PER_HOUR=60
USE_LIGHTWEIGHT_SENTIMENT=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
ENABLE_DOCS=true
ENABLE_STARTUP_SYNC=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST_REQUESTS=20
ENABLE_GZIP=true
STARTUP_SYNC_ASYNC=true
AUTO_CREATE_TABLES=true
SECRET_KEY=change-me-in-production
ADMIN_API_KEY=

# Optional experiments remain off for the supported core app.
ENABLE_RAG=false
ENABLE_USER_FEATURES=false
# Must match the frontend value when running behind its proxy.
PROXY_SHARED_SECRET=
